# systemd --user unit for the Bobbit gateway, fronted by a Cloudflare Tunnel.
# Installed to ~/.config/systemd/user/bobbit.service by setup.sh, which
# substitutes the placeholders below:
#   <CHECKOUT_DIR>  source checkout (WorkingDirectory + ./run path)
#   <BOBBIT_CWD>    Bobbit project cwd passed via --cwd
#   <NODE_BIN_DIR>  dir prepended to PATH so a host Node 20+ is found
#   <PORT>          loopback port Bobbit binds (default 3001)
#   <EXEC_PREFIX>   runtime exec prefix BEFORE ./run. Empty for the default
#                   host-Node runtime; for the toolbox runtime it renders
#                   `toolbox run -c <container> ` (note the trailing space).
#
# Bobbit MUST bind the host loopback (--host 127.0.0.1) to stay in localhost
# mode (no Bobbit token); Cloudflare Access is the sole auth gate. Binding to
# 0.0.0.0/:: would flip Bobbit back to requiring its own token — do not do that.
#
# PATH prepends a host Node 20+ via the <NODE_BIN_DIR> placeholder, which
# setup.sh substitutes (default portable install under ~/.local/node/bin). The
# host base image has no Node; see the runbook for the portable-tarball /
# rpm-ostree options.
[Unit]
Description=Bobbit gateway (localhost mode, fronted by Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=<NODE_BIN_DIR>:/usr/local/bin:/usr/bin:/bin
Environment=BOBBIT_NO_OPEN=1
WorkingDirectory=<CHECKOUT_DIR>
ExecStart=<EXEC_PREFIX><CHECKOUT_DIR>/run --host 127.0.0.1 --no-tls --port <PORT> --cwd <BOBBIT_CWD>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
